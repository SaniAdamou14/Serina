# Environment Configuration for Serina Evolution API
# WAMP64 MySQL Database Configuration

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=serina_evolution
DB_USER=root
DB_PASSWORD=

# Server Configuration
PORT=3001
NODE_ENV=development
API_VERSION=v1

# CORS Settings
CORS_ORIGIN=http://localhost:5173
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_HEADERS=Origin,X-Requested-With,Content-Type,Accept,Authorization

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# JWT Configuration (if authentication needed)
JWT_SECRET=serina_evolution_jwt_secret_key_2024
JWT_EXPIRES_IN=24h

# Logging
LOG_LEVEL=info
LOG_FILE=logs/api.log

# Real-time Updates
WEBSOCKET_PORT=3002
UPDATE_INTERVAL_MS=1000
MAX_CONNECTIONS=1000

# Simulation Engine Configuration
SIMULATION_HOST=127.0.0.1
SIMULATION_PORT=8080
SIMULATION_TIMEOUT=30000

# Performance Monitoring
METRICS_ENABLED=true
METRICS_INTERVAL=5000
PERFORMANCE_TRACKING=true

# File Uploads (if needed)
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Cache Configuration
CACHE_TTL=300
CACHE_MAX_SIZE=100

# Development Settings
DEBUG=true
VERBOSE_LOGGING=true
AUTO_MIGRATE=true
AUTO_SEED=false