{
  "name": "serina-evolution-project",
  "version": "1.0.0",
  "description": "Serina Evolution Simulation - Complete Project",
  "private": true,
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "install:all": "npm install && cd api && npm install && cd ../web && npm install",
    "start:api": "cd api && npm start",
    "start:web": "cd web && npm run dev",
    "dev": "concurrently \"npm run start:api\" \"npm run start:web\"",
    "start:both": "concurrently \"npm run start:api\" \"npm run start:web\"",
    "build": "cd web && npm run build",
    "test": "cd api && npm test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
